{
    "exempt": [
        ".claude/**",
        ".ai/**",
        "vendor/**",
        "node_modules/**",
        "storage/**",
        "bootstrap/cache/**",
        "public/build/**",
        "AGENTS.md",
        "CLAUDE.md",
        "resources/js/actions/**",
        "resources/js/routes/**",
        "resources/js/wayfinder/**"
    ],
    "skills": [],
    "search_docs": {
        "required": true,
        "globs": [
            "app/**/*.php",
            "routes/**/*.php",
            "database/**/*.php",
            "config/**/*.php",
            "bootstrap/app.php",
            "resources/js/**",
            "resources/views/**"
        ]
    },
    "quality": {
        "enabled": true,
        "max_blocks": 1,
        "watch": [
            "app",
            "bootstrap/app.php",
            "config",
            "database",
            "routes",
            "resources/js",
            "resources/views",
            "tests"
        ],
        "source_extensions": [
            "php",
            "js",
            "jsx",
            "ts",
            "tsx",
            "mjs",
            "cjs",
            "vue",
            "svelte",
            "css",
            "scss",
            "json"
        ],
        "format": "vendor/bin/pint {files}",
        "static": "vendor/bin/phpstan analyse --no-progress --error-format=raw --memory-limit=1G {files}",
        "static_paths": [
            "app/",
            "bootstrap/app.php",
            "config/",
            "database/",
            "routes/"
        ],
        "tests": "php artisan test --compact",
        "frontend": ""
    },
    "review": {
        "enabled": true,
        "mode": "on_request",
        "agent": "boost-reviewer",
        "globs": [
            "app/**",
            "bootstrap/app.php",
            "config/**",
            "database/**",
            "routes/**",
            "resources/js/**",
            "resources/views/**"
        ]
    }
}
