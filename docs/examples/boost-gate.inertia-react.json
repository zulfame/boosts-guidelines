{
    "exempt": [
        ".claude/**",
        ".ai/**",
        "vendor/**",
        "node_modules/**",
        "storage/**",
        "bootstrap/cache/**",
        "public/build/**",
        "AGENTS.md",
        "CLAUDE.md"
    ],
    "skills": [
        {
            "glob": "app/**/*.php",
            "skills": [
                "laravel-best-practices"
            ]
        },
        {
            "glob": "routes/**/*.php",
            "skills": [
                "laravel-best-practices"
            ]
        },
        {
            "glob": "database/**/*.php",
            "skills": [
                "laravel-best-practices"
            ]
        },
        {
            "glob": "config/**/*.php",
            "skills": [
                "laravel-best-practices"
            ]
        },
        {
            "glob": "bootstrap/app.php",
            "skills": [
                "laravel-best-practices"
            ]
        },
        {
            "glob": "tests/**",
            "skills": [
                "testing-best-practices"
            ]
        },
        {
            "glob": "app/Actions/Fortify/**",
            "skills": [
                "fortify-development"
            ]
        },
        {
            "glob": "resources/js/**",
            "skills": [
                "inertia-react-development"
            ]
        },
        {
            "glob": "resources/css/**",
            "skills": [
                "tailwindcss-development"
            ]
        },
        {
            "glob": "resources/views/**",
            "skills": [
                "tailwindcss-development"
            ]
        }
    ],
    "search_docs": {
        "required": true,
        "globs": [
            "app/**/*.php",
            "routes/**/*.php",
            "database/**/*.php",
            "config/**/*.php",
            "bootstrap/app.php",
            "resources/js/**",
            "resources/views/**"
        ]
    },
    "quality": {
        "enabled": true,
        "max_blocks": 3,
        "watch": [
            "app",
            "bootstrap/app.php",
            "config",
            "database",
            "routes",
            "resources/js",
            "resources/views",
            "tests"
        ],
        "source_extensions": [
            "php",
            "js",
            "jsx",
            "ts",
            "tsx",
            "mjs",
            "cjs",
            "vue",
            "svelte",
            "css",
            "scss",
            "json"
        ],
        "format": "vendor/bin/pint {files}",
        "static": "vendor/bin/phpstan analyse --no-progress --error-format=raw --memory-limit=1G {files}",
        "static_paths": [
            "app/",
            "bootstrap/app.php",
            "config/",
            "database/",
            "routes/"
        ],
        "tests": "php artisan test --compact",
        "frontend": "npm run types:check"
    },
    "review": {
        "enabled": true,
        "agent": "boost-reviewer",
        "globs": [
            "app/**",
            "bootstrap/app.php",
            "config/**",
            "database/**",
            "routes/**",
            "resources/js/**",
            "resources/views/**"
        ]
    }
}
